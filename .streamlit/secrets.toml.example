# Vzor. Skopírujte ako .streamlit/secrets.toml (lokálne) alebo vložte do
# Streamlit Community Cloud: App settings -> Secrets. Tento súbor s reálnymi hodnotami nikdy nedávajte na GitHub.

admin_heslo = "sem-dajte-dlhe-heslo-spravcu"

# ID tabuľky = časť adresy medzi /d/ a /edit
# https://docs.google.com/spreadsheets/d/TOTO_JE_ID/edit
sheet_id = "TOTO_JE_ID"

# Obsah JSON kľúča servisného účtu z Google Cloud (rovnaké názvy polí ako v JSON súbore)
[gcp_service_account]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "nazov@projekt.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"
